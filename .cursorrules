### Nomenclatura
- **Componentes:** PascalCase (`OrderList.tsx`)
- **Hooks:** camelCase con prefijo `use` (`useOrders.ts`)
- **Utils:** camelCase (`formatCurrency.ts`)
- **Types:** PascalCase (`Order`, `OrderStatus`)
- **Archivos:** kebab-case o PascalCase (consistente)
- **CSS Classes:** Tailwind utilities (no custom CSS a menos que sea necesario)

### Componentes React

#### Estructura de Componente
```typescript
// components/orders/order-card.tsx
'use client'; // Solo si necesita interactividad

import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Order } from '@/types/api';
import { formatCurrency } from '@/lib/utils';

interface OrderCardProps {
  order: Order;
  onView?: (id: string) => void;
  onUpdateStatus?: (id: string) => void;
}

export function OrderCard({ order, onView, onUpdateStatus }: OrderCardProps) {
  return (
    <Card>
      <CardHeader>
        <h3 className="text-lg font-semibold">Order #{order.id}</h3>
      </CardHeader>
      <CardContent>
        {/* Content */}
      </CardContent>
    </Card>
  );
}
```

#### Reglas de Componentes
- **Server Components por defecto** (Next.js App Router)
- **'use client'** solo cuando necesites:
  - Hooks (useState, useEffect, etc.)
  - Event handlers (onClick, onChange)
  - Browser APIs (localStorage, window)
- **Props tipadas** con TypeScript
- **Componentes pequeños** y reutilizables
- **Composición** sobre herencia
- **Extract logic** a custom hooks

### shadcn/ui Usage

#### Instalación de Componentes
```bash
npx shadcn@latest add button
npx shadcn@latest add card
npx shadcn@latest add dialog
```

#### Personalización
- **Modificar** componentes en `components/ui/`
- **Extender** con variants usando `cva` (class-variance-authority)
- **Mantener** estructura de Radix UI
- **No modificar** directamente node_modules

### Forms con React Hook Form + Zod

```typescript
// components/auth/login-form.tsx
'use client';

import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from '@/components/ui/form';

const loginSchema = z.object({
  email: z.string().email('Invalid email'),
  password: z.string().min(6, 'Password must be at least 6 characters'),
});

type LoginForm = z.infer<typeof loginSchema>;

export function LoginForm() {
  const form = useForm<LoginForm>({
    resolver: zodResolver(loginSchema),
    defaultValues: {
      email: '',
      password: '',
    },
  });

  const onSubmit = async (data: LoginForm) => {
    // Handle submission
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-4">
        <FormField
          control={form.control}
          name="email"
          render={({ field }) => (
            <FormItem>
              <FormLabel>Email</FormLabel>
              <FormControl>
                <Input type="email" {...field} />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
        <Button type="submit">Login</Button>
      </form>
    </Form>
  );
}
```

### API Client con TanStack Query

```typescript
// lib/api/client.ts
import axios from 'axios';
import Cookies from 'js-cookie';

const api = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_URL || 'http://localhost:3001',
});

// Interceptor para agregar token
api.interceptors.request.use((config) => {
  const token = Cookies.get('access_token');
  if (token) {
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

export default api;

// lib/hooks/use-orders.ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { getApiClient } from '@/lib/api/mock';
import { Order, OrderFilters } from '@/types/api';

export function useOrders(filters?: OrderFilters) {
  const apiClient = getApiClient();
  
  return useQuery({
    queryKey: ['orders', filters],
    queryFn: async () => {
      return await apiClient.getOrders(filters);
    },
  });
}

export function useUpdateOrderStatus() {
  const queryClient = useQueryClient();
  const apiClient = getApiClient();
  
  return useMutation({
    mutationFn: async ({ id, toStatus, notes }: { id: string; toStatus: string; notes?: string }) => {
      return await apiClient.updateOrderStatus(id, { to_status: toStatus, notes });
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['orders'] });
    },
  });
}
```

### Factory Pattern para Mock/API

```typescript
// lib/api/mock/index.ts
import { ApiClient } from './types';
import { MockApiClient } from './mock-client';
import { RealApiClient } from './real-client';

export function getApiClient(): ApiClient {
  const mode = process.env.NEXT_PUBLIC_API_MODE || 'mock';
  
  if (mode === 'mock') {
    return new MockApiClient();
  }
  
  return new RealApiClient();
}
```

## Patrones Específicos

### 1. Loading States
```typescript
// Usar Skeleton en lugar de Spinner
import { Skeleton } from '@/components/ui/skeleton';

export function OrderListSkeleton() {
  return (
    <div className="space-y-4">
      {Array.from({ length: 5 }).map((_, i) => (
        <Skeleton key={i} className="h-20 w-full" />
      ))}
    </div>
  );
}
```

### 2. Error States
```typescript
// components/shared/error-state.tsx
import { AlertCircle } from 'lucide-react';
import { Button } from '@/components/ui/button';

interface ErrorStateProps {
  message: string;
  onRetry?: () => void;
}

export function ErrorState({ message, onRetry }: ErrorStateProps) {
  return (
    <div className="flex flex-col items-center justify-center p-8 text-center">
      <AlertCircle className="h-12 w-12 text-destructive mb-4" />
      <p className="text-muted-foreground mb-4">{message}</p>
      {onRetry && <Button onClick={onRetry}>Try Again</Button>}
    </div>
  );
}
```

### 3. Empty States
```typescript
// components/shared/empty-state.tsx
import { Package } from 'lucide-react';
import { Button } from '@/components/ui/button';

interface EmptyStateProps {
  title: string;
  description: string;
  action?: {
    label: string;
    onClick: () => void;
  };
}

export function EmptyState({ title, description, action }: EmptyStateProps) {
  return (
    <div className="flex flex-col items-center justify-center p-8 text-center">
      <Package className="h-12 w-12 text-muted-foreground mb-4" />
      <h3 className="text-lg font-semibold mb-2">{title}</h3>
      <p className="text-muted-foreground mb-4">{description}</p>
      {action && <Button onClick={action.onClick}>{action.label}</Button>}
    </div>
  );
}
```

### 4. Toast Notifications
```typescript
// Usar sonner o shadcn toast
import { toast } from 'sonner';

// Success
toast.success('Order status updated successfully');

// Error
toast.error('Failed to update order status');

// Loading
const toastId = toast.loading('Updating order...');
// Later: toast.success('Order updated', { id: toastId });
```

### 5. Status Badges
```typescript
// components/orders/order-status-badge.tsx
import { Badge } from '@/components/ui/badge';
import { OrderStatus } from '@/types/api';

const statusColors: Record<OrderStatus, string> = {
  ASSIGNED: 'bg-blue-500',
  IN_TRANSIT: 'bg-yellow-500',
  DELIVERED: 'bg-green-500',
  FAILED: 'bg-red-500',
  CANCELLED: 'bg-gray-500',
};

export function OrderStatusBadge({ status }: { status: OrderStatus }) {
  return (
    <Badge className={statusColors[status]}>
      {status.replace('_', ' ')}
    </Badge>
  );
}
```

## Testing

### Configuración Jest
- Usar `next/jest` para configuración
- Coverage threshold: 80% (branches, functions, lines, statements)
- Test environment: `jest-environment-jsdom`
- Setup file: `jest.setup.js`

### Estructura de Tests
```
components/
└── [feature]/
    └── __tests__/
        └── [component].test.tsx
lib/
└── hooks/
    └── __tests__/
        └── [hook].test.ts
lib/
└── utils/
    └── __tests__/
        └── [util].test.ts
```

### Ejemplo de Test
```typescript
// components/orders/__tests__/order-status-badge.test.tsx
import { render, screen } from '@testing-library/react';
import { OrderStatusBadge } from '../order-status-badge';

describe('OrderStatusBadge', () => {
  it('renders ASSIGNED status correctly', () => {
    render(<OrderStatusBadge status="ASSIGNED" />);
    expect(screen.getByText('ASSIGNED')).toBeInTheDocument();
  });
});
```

### Comandos de Testing
```bash
npm test                    # Ejecutar tests
npm test:watch             # Watch mode
npm test:coverage          # Con coverage
```

## Consideraciones de Seguridad

1. **Validación de Rol:** Solo usuarios con rol `DRIVER` pueden acceder
2. **Filtrado Automático:** Todas las queries de órdenes deben filtrar por `driver_id` del usuario autenticado
3. **Validación de Transiciones:** El frontend debe validar transiciones permitidas antes de enviar
4. **Tokens:** Guardar en cookies (considerar httpOnly si es posible)

