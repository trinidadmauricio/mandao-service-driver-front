# ============================================
# Mandao Service - Driver Front
# Variables de Entorno (Template)
# ============================================
# Copia este archivo a .env y ajusta los valores según tu entorno

# Modo de operación de la API
# Valores posibles: 'mock' | 'api'
# - 'mock': Usa datos simulados (desarrollo sin backend)
# - 'api': Conecta con la API real
# Default: 'mock'
NEXT_PUBLIC_API_MODE=mock

# URL base de la API de Mandao Service
# Solo la URL base, sin /api/v1 (se agrega automáticamente)
# Default: 'http://localhost:3001'
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL de la aplicación frontend (opcional)
# Útil para generar URLs absolutas en emails, notificaciones, etc.
# Default: 'http://localhost:3002'
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ============================================
# Notas:
# - Todas las variables que empiezan con NEXT_PUBLIC_ son expuestas al cliente
# - Las variables sin NEXT_PUBLIC_ solo están disponibles en el servidor
# - Para desarrollo local, puedes usar .env.local para sobreescribir valores
# ============================================
